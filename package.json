{
  "name": "attic-projects-catalog-composer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Internal catalog image composer for Attic Projects",
  "scripts": {
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm run build --prefix client",
    "probe:menaia": "npm run probe:menaia --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
