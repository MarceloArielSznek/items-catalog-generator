OPENAI_API_KEY=sk-your-key-here
PORT=3001
NODE_ENV=development
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=src/uploads
GENERATED_DIR=src/generated

# Payload CMS (server-side). API_BASE_URL required for /api/payload proxy.
# In production, users sign in via the app; API_USER/API_PASSWORD are optional (dev auto-login only).
API_BASE_URL=https://www.example.com
API_USER=
API_PASSWORD=
API_TIMEOUT_MS=15000

# Client dev auto-login (optional): create client/.env with VITE_PAYLOAD_ADMIN_EMAIL and VITE_PAYLOAD_ADMIN_PASSWORD
