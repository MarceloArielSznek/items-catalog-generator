# ================================
# Server
# ================================
PORT=3005
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=src/uploads
GENERATED_DIR=src/generated

# ================================
# Feature flags
# ================================
# Legacy item generator (image compose / scenes / library / payload / enrich
# routes + the "Price Book" UI). On in dev, off in production builds by default.
# Set both to "true" to force-enable, or "false" to force-disable.
#   ENABLE_ITEM_GENERATOR       → backend API routes (read by the server)
#   VITE_ENABLE_ITEM_GENERATOR  → frontend routes/nav (read by Vite at build)
# ENABLE_ITEM_GENERATOR=false
# VITE_ENABLE_ITEM_GENERATOR=false

# ================================
# Menaia / Attic-Tech API
# ================================
# URL of the Menaia API (local or production)
MENAIA_API_URL=http://localhost:3000
API_TIMEOUT_MS=15000

# Admin credentials used to authenticate against the Menaia API
MENAIA_EMAIL=admin@my-org.com
MENAIA_PASSWORD=YourPassword123!

# ================================
# Supabase (optional)
# ================================
# Only needed for the "Admin user (JWT)" deploy mode, which signs in as a real
# org admin instead of using the service key. Normal deploys and demo data run
# entirely on MENAIA_API_KEY.
# Local (Docker): http://127.0.0.1:54321
# Production:     https://your-project-ref.supabase.co
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ================================
# AI / Image generation
# ================================
# OpenAI — required for AI image generation and pricebook research
OPENAI_API_KEY=sk-your-key-here

# Anthropic Claude — vision scoring and AI enrichment (optional)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ================================
# Image search
# ================================
# Google Custom Search — web image candidates per item
GOOGLE_SEARCH_API_KEY=your-google-api-key
GOOGLE_SEARCH_CX=your-custom-search-cx

# Serper.dev — alternative web image search
SERPER_API_KEY=your-serper-api-key

# ================================
# Optional / Deployment
# ================================
# Vercel preview protection token (only needed if target is behind Vercel auth)
# VERCEL_TOKEN=your-vercel-preview-cookie-token
